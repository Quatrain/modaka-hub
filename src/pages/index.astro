---
import Layout from '../layouts/Layout.astro';
import { CurationWorkbenchApp } from '../components/CurationWorkbenchApp';

const user = Astro.locals.user
  ? {
      ...Astro.locals.user,
      isAdmin:
        Astro.locals.user.roles?.includes('admin')
    }
  : null;
---

<Layout title="Modaka-Hub - Curation OKF">
	<CurationWorkbenchApp initialUser={user} client:only="react" />
</Layout>
