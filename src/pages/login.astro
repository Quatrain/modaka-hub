---
import { config } from '../lib/config';

const error = Astro.url.searchParams.get('error');
const rejectedEmail = Astro.url.searchParams.get('email');
const hasBetaCodes = config.betaAccessCodes.length > 0;
const defaultTab = error === 'invalid_beta_code' || error === 'missing_beta_code' || (hasBetaCodes && !error) ? 'beta' : 'password';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Connexion — {config.appTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      :root {
        --bg-dark: #090d12;
        --card-bg: rgba(18, 24, 33, 0.92);
        --border-color: rgba(46, 160, 67, 0.35);
        --primary-green: #2ea043;
        --primary-green-hover: #3fb950;
        --accent-glow: rgba(46, 160, 67, 0.25);
        --text-main: #f0f6fc;
        --text-muted: #8b949e;
        --input-bg: rgba(13, 17, 23, 0.9);
        --input-border: rgba(48, 54, 61, 0.9);
        --error-bg: rgba(248, 81, 73, 0.15);
        --error-border: rgba(248, 81, 73, 0.4);
        --error-text: #ff7b72;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: radial-gradient(circle at top center, #16221a 0%, #090d12 100%);
        color: var(--text-main);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
      }

      .login-card {
        background: var(--card-bg);
        backdrop-filter: blur(24px);
        border: 1px solid var(--border-color);
        border-radius: 18px;
        padding: 2.5rem 2.25rem;
        width: 100%;
        max-width: 460px;
        box-shadow: 0 24px 48px rgba(0, 0, 0, 0.6), 0 0 90px var(--accent-glow);
        text-align: center;
      }

      .logo-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(46, 160, 67, 0.12);
        border: 1px solid rgba(46, 160, 67, 0.35);
        color: #3fb950;
        padding: 0.3rem 0.85rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 1rem;
      }

      h1 {
        font-size: 1.85rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        margin-bottom: 0.4rem;
        background: linear-gradient(135deg, #ffffff 50%, #a1aab5 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
      }

      p.subtitle {
        font-size: 0.88rem;
        color: var(--text-muted);
        line-height: 1.5;
        margin-bottom: 1.5rem;
      }

      /* Auth Mode Switcher */
      .auth-tabs {
        display: flex;
        background: rgba(13, 17, 23, 0.8);
        border: 1px solid rgba(48, 54, 61, 0.8);
        border-radius: 12px;
        padding: 4px;
        margin-bottom: 1.5rem;
        gap: 4px;
      }

      .tab-btn {
        flex: 1;
        padding: 0.6rem 0.8rem;
        background: transparent;
        border: none;
        border-radius: 8px;
        color: var(--text-muted);
        font-family: inherit;
        font-size: 0.85rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .tab-btn.active {
        background: rgba(46, 160, 67, 0.2);
        color: #3fb950;
        border: 1px solid rgba(46, 160, 67, 0.4);
      }

      .alert {
        padding: 0.85rem 1rem;
        border-radius: 10px;
        font-size: 0.85rem;
        text-align: left;
        line-height: 1.45;
        margin-bottom: 1.5rem;
      }

      .alert.error {
        background: var(--error-bg);
        border: 1px solid var(--error-border);
        color: var(--error-text);
      }

      .alert code {
        background: rgba(0, 0, 0, 0.3);
        padding: 0.15rem 0.35rem;
        border-radius: 4px;
        font-family: monospace;
      }

      form.auth-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        text-align: left;
      }

      .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      .form-group label {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-muted);
      }

      .form-input {
        width: 100%;
        padding: 0.8rem 1rem;
        background: var(--input-bg);
        border: 1px solid var(--input-border);
        border-radius: 10px;
        color: var(--text-main);
        font-size: 0.95rem;
        font-family: inherit;
        outline: none;
        transition: all 0.2s ease;
      }

      .form-input:focus {
        border-color: var(--primary-green);
        box-shadow: 0 0 0 3px rgba(46, 160, 67, 0.25);
      }

      .form-input::placeholder {
        color: rgba(139, 148, 158, 0.6);
      }

      .form-input.code-input {
        font-family: monospace;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        font-weight: 700;
        text-align: center;
        font-size: 1.1rem;
      }

      .btn-submit {
        width: 100%;
        padding: 0.85rem 1.25rem;
        margin-top: 0.5rem;
        background: linear-gradient(135deg, #2ea043 0%, #238636 100%);
        color: #ffffff;
        font-size: 0.95rem;
        font-weight: 700;
        font-family: inherit;
        border-radius: 10px;
        border: 1px solid rgba(255, 255, 255, 0.15);
        cursor: pointer;
        transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
        box-shadow: 0 4px 16px rgba(46, 160, 67, 0.35);
      }

      .btn-submit:hover {
        background: linear-gradient(135deg, #3fb950 0%, #2ea043 100%);
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(46, 160, 67, 0.45);
      }

      .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 1.5rem 0 1.25rem 0;
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .divider::before,
      .divider::after {
        content: '';
        flex: 1;
        border-bottom: 1px solid rgba(48, 54, 61, 0.6);
      }

      .divider::before {
        margin-right: 0.75rem;
      }

      .divider::after {
        margin-left: 0.75rem;
      }

      .btn-sso {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        width: 100%;
        padding: 0.75rem 1rem;
        background: rgba(33, 38, 45, 0.7);
        color: var(--text-main);
        font-size: 0.85rem;
        font-weight: 600;
        border-radius: 10px;
        text-decoration: none;
        border: 1px solid rgba(48, 54, 61, 0.8);
        transition: all 0.2s ease;
      }

      .btn-sso:hover {
        background: rgba(48, 54, 61, 0.8);
        border-color: rgba(46, 160, 67, 0.5);
      }

      .footer-note {
        margin-top: 1.75rem;
        font-size: 0.75rem;
        color: var(--text-muted);
        border-top: 1px solid rgba(48, 54, 61, 0.4);
        padding-top: 1rem;
      }

      .domain-badge {
        color: #3fb950;
        font-weight: 700;
      }
    </style>
  </head>
  <body>
    <div class="login-card">
      <div class="logo-badge">
        🌱 {config.badgeLabel || config.appTitle}
      </div>

      <h1>{config.appTitle}</h1>
      <p class="subtitle">
        {config.appSubtitle}
      </p>

      {error === 'invalid_credentials' && (
        <div class="alert error">
          ⚠️ <strong>Identifiants incorrects</strong><br />
          L'email ou le mot de passe est invalide.
        </div>
      )}

      {error === 'domain_restricted' && (
        <div class="alert error">
          ⛔ <strong>Accès restreint</strong><br />
          L'adresse <code>{rejectedEmail || 'non-autorisée'}</code> n'est pas autorisée. Domaines acceptés: <span class="domain-badge">{config.allowedEmailDomains.join(', ') || 'aucun'}</span>.
        </div>
      )}

      {error === 'invalid_beta_code' && (
        <div class="alert error">
          🎟️ <strong>Code Bêta Invalide</strong><br />
          Ce code d'invitation n'est pas reconnu ou a expiré.
        </div>
      )}

      {error === 'missing_beta_code' && (
        <div class="alert error">
          🎟️ <strong>Code requis</strong><br />
          Veuillez renseigner votre code d'accès bêta.
        </div>
      )}

      {error === 'auth_required' && (
        <div class="alert error">
          🔒 <strong>Authentification requise</strong><br />
          Veuillez vous connecter pour accéder à l'atelier de curation.
        </div>
      )}

      <!-- Auth Switcher Tabs -->
      <div class="auth-tabs">
        <button
          type="button"
          class={`tab-btn ${defaultTab === 'beta' ? 'active' : ''}`}
          id="tab-beta"
          onclick="switchTab('beta')"
        >
          🎟️ Code Bêta Testeur
        </button>
        <button
          type="button"
          class={`tab-btn ${defaultTab === 'password' ? 'active' : ''}`}
          id="tab-password"
          onclick="switchTab('password')"
        >
          🔑 Collaborateur
        </button>
      </div>

      <!-- Section 1: Code Bêta Testeur -->
      <div id="section-beta" style={defaultTab === 'beta' ? 'display: block;' : 'display: none;'}>
        <form class="auth-form" method="POST" action="/api/auth/beta-login">
          <div class="form-group">
            <label for="beta-code">Code d'accès Bêta</label>
            <input
              id="beta-code"
              name="code"
              type="text"
              class="form-input code-input"
              placeholder="BETA-XXXX-2026"
              required
              autocomplete="off"
            />
          </div>

          <div class="form-group">
            <label for="beta-name">Votre Nom ou Pseudo (optionnel)</label>
            <input
              id="beta-name"
              name="name"
              type="text"
              class="form-input"
              placeholder="Ex: Paul V."
              autocomplete="name"
            />
          </div>

          <button type="submit" class="btn-submit">
            Valider l'accès Bêta
          </button>
        </form>
      </div>

      <!-- Section 2: Formulaire Direct Email / Mot de Passe & SSO -->
      <div id="section-password" style={defaultTab === 'password' ? 'display: block;' : 'display: none;'}>
        <form class="auth-form" method="POST" action="/api/auth/password-login">
          <div class="form-group">
            <label for="email">Adresse Email Professionnelle</label>
            <input
              id="email"
              name="email"
              type="email"
              class="form-input"
              placeholder={config.allowedEmailDomains[0] ? `prenom.nom${config.allowedEmailDomains[0]}` : 'prenom.nom@domaine.com'}
              required
              autocomplete="email"
            />
          </div>

          <div class="form-group">
            <label for="password">Mot de Passe</label>
            <input
              id="password"
              name="password"
              type="password"
              class="form-input"
              placeholder="••••••••••••"
              required
              autocomplete="current-password"
            />
          </div>

          <button type="submit" class="btn-submit">
            Se connecter
          </button>
        </form>

        <div class="divider">ou</div>

        <!-- Bouton SSO OAuth -->
        <a href="/api/auth/login" class="btn-sso">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
            <polyline points="10 17 15 12 10 7" />
            <line x1="15" y1="12" x2="3" y2="12" />
          </svg>
          Connexion SSO / Entreprise
        </a>
      </div>

      <div class="footer-note">
        {config.allowedEmailDomains.length > 0 && (
          <span>Restriction collaborateurs: <span class="domain-badge">{config.allowedEmailDomains.join(', ')}</span> • </span>
        )}
        Codes Bêta actifs
      </div>
    </div>

    <script is:inline>
      function switchTab(tab) {
        const secBeta = document.getElementById('section-beta');
        const secPass = document.getElementById('section-password');
        const btnBeta = document.getElementById('tab-beta');
        const btnPass = document.getElementById('tab-password');

        if (tab === 'beta') {
          secBeta.style.display = 'block';
          secPass.style.display = 'none';
          btnBeta.classList.add('active');
          btnPass.classList.remove('active');
        } else {
          secBeta.style.display = 'none';
          secPass.style.display = 'block';
          btnPass.classList.add('active');
          btnBeta.classList.remove('active');
        }
      }
    </script>
  </body>
</html>
