# Application Metadata
APP_TITLE=Modaka Hub
APP_SUBTITLE=Multi-Source Knowledge Curation & OKF Structuring Platform
DEFAULT_SOA=modaka/authority

# AI Ingestion Engine (gemini, deepseek, qwen, openai)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional DeepSeek Engine
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional Qwen Engine
# QWEN_API_KEY=
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# OKF Git Storage Configuration
GIT_MODE=local
GIT_LOCAL_PATH=./data/okf
DOCUMENT_STORAGE_PATH=./data/okf/assets
GIT_BRANCH=develop
GIT_REPO_OWNER=Quatrain
GIT_REPO_NAME=knowledge
STORAGE_TYPE=local

# S3 Storage Configuration (required when STORAGE_TYPE=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Supabase Auth Configuration
PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAINS=*
